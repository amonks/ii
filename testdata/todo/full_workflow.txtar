# setup repo
mkdir repo
cd repo
exec jj git init

# create todo
stdin input.txt
exec $II create --title 'Fix the login bug' -t bug -p 1
stdout 'Created todo'
stdout 'Fix the login bug'

# list todos
exec $II list --json
todoid stdout 'Fix the login bug' TODO_ID
stdout '"type": "bug"'
stdout '"priority": 1'

# show todo
exec $II show $TODO_ID
stdout 'Fix the login bug'
stdout 'bug'

# start todo
exec $II start $TODO_ID
stdout 'Started'

exec $II list --json
stdout '"status": "in_progress"'

# create todo with dependency
exec $II create --title 'Write tests' --deps $TODO_ID
stdout 'Created todo'

exec $II list --json
todoid stdout 'Write tests' CHILD_ID

# add dependency
exec $II create --title 'Blocker task'
exec $II list --json
todoid stdout 'Blocker task' BLOCKER_ID
exec $II dep add $CHILD_ID $BLOCKER_ID
stdout 'Added dependency'

# dep tree
exec $II dep tree $CHILD_ID
stdout 'Write tests'

# ready
exec $II ready --json
! stdout 'Write tests'
stdout 'Blocker task'

# close todo
exec $II close $TODO_ID
stdout 'Closed'

exec $II show $TODO_ID --json
stdout '"status": "closed"'

# reopen todo
exec $II reopen $TODO_ID
stdout 'Reopened'

exec $II show $TODO_ID --json
stdout '"status": "open"'

# finish todo
exec $II finish $TODO_ID
stdout 'Finished'

exec $II show $TODO_ID --json
stdout '"status": "done"'

# list default excludes done
exec $II list --json
! stdout 'Fix the login bug'

# list all includes done
exec $II list --all --json
stdout 'Fix the login bug'
stdout '"status": "done"'

# list filter by status
exec $II list --status open --json
stdout '"status": "open"'
! stdout '"status": "closed"'

# list filter by type
exec $II list --status done --type bug --json
stdout '"type": "bug"'
stdout '"status": "done"'
! stdout '"type": "task"'

# list filter by title
exec $II list --status done --title login --json
stdout 'Fix the login bug'

-- repo/input.txt --
y
