# setup repo
mkdir repo
cd repo
exec jj git init

# create blocker and blocked
stdin input.txt
exec $II create --title 'Blocker' -p 0
exec $II create --title 'Blocked' -p 0

exec $II list --json
todoid stdout 'Blocker' BLOCKER_ID
todoid stdout 'Blocked' BLOCKED_ID

exec $II dep add $BLOCKED_ID $BLOCKER_ID

# only blocker should be ready
exec $II ready --json
stdout 'Blocker'
! stdout 'Blocked'

exec $II close $BLOCKER_ID

# blocked should be ready
exec $II ready --json
stdout 'Blocked'
! stdout 'Blocker'

-- repo/input.txt --
y
